{
  "name": "shopkart-mern-project",
  "version": "1.0.0",
  "description": "ShopKart Full-Stack MERN E-Commerce Application (Independent Backend & Frontend)",
  "scripts": {
    "build": "cd backend && npm install",
    "postinstall": "cd backend && npm install",
    "start": "node backend/index.js",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "razorpay": "^2.9.8"
  },
  "keywords": [
    "mern",
    "react",
    "express",
    "mongodb",
    "node",
    "shopkart"
  ],
  "author": "",
  "license": "ISC"
}
